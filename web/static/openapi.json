  },
  "/hosts/{host}/vms": {
   "post": {
    "summary": "Create a VM",
    "description": "Minimum role: operator.",
    "responses": {
     "201": {
      "description": "Created",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "host": {
           "type": "string"
          },
          "name": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/NewVM"
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}": {
   "get": {
    "summary": "Get a VM",
    "description": "Minimum role: read-only.",
    "responses": {
     "200": {
      "description": "VM",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/VM"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "delete": {
    "summary": "Delete a VM and its disks",
    "description": "Minimum role: admin.",
    "responses": {
     "202": {
      "description": "Accepted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "patch": {
    "summary": "Update a VM",
    "description": "Requires vm.config.",
    "responses": {
     "200": {
      "description": "VM",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/VM"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/VMUpdate"
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}/power": {
   "post": {
    "summary": "Change power state",
    "description": "Minimum role: operator.",
    "responses": {
     "202": {
      "description": "Accepted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "action"
        ],
        "properties": {
         "action": {
          "type": "string",
          "enum": [
           "start",
           "stop",
           "poweroff",
           "restart",
           "pause",
           "unpause"
          ]
         }
        }
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}/migrate": {
   "post": {
    "summary": "Move a VM to another host; live when running",
    "description": "Minimum role: admin.",
    "responses": {
     "202": {
      "description": "Accepted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "to"
        ],
        "properties": {
         "to": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}/snapshots": {
   "get": {
    "summary": "List snapshots",
