      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/hosts/{host}/vms/{name}/snapshots/{snap}": {
   "delete": {
    "summary": "Delete a snapshot",
    "description": "Minimum role: operator.",
    "responses": {
     "202": {
      "description": "Accepted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "snap",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/hosts/{host}/vms/{name}/snapshots/{snap}/restore": {
   "post": {
    "summary": "Restore a snapshot; the VM must be stopped",
    "description": "Minimum role: operator.",
    "responses": {
     "202": {
      "description": "Accepted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "snap",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/hosts/{host}/vms/{name}/backups": {
   "get": {
    "summary": "List backup sessions",
    "description": "Minimum role: read-only.",
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Sessions",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/BackupSession"
         }
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Start a backup session",
    "description": "Minimum role: operator. Takes a crash-consistent snapshot of every disk (application-consistent when the guest agent is running). Keep the latest session as the base for the next incremental backup and delete older ones.",
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "201": {
      "description": "Session",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BackupSession"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}/backups/{id}": {
   "delete": {
    "summary": "Delete a backup session",
    "description": "Minimum role: operator.",
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Deleted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}/backups/{id}/disks/{disk}/changes": {
   "get": {
    "summary": "Changed block map",
    "description": "Minimum role: operator. Without base: allocated data of the whole disk. With base: data written since that session. Zero extents read as zeros in this session and may be applied as holes.",
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "disk",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "base",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "description": "An earlier session id of the same VM."
     }
    ],
    "responses": {
     "200": {
      "description": "Extents",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Changes"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/vms/{name}/backups/{id}/disks/{disk}/data": {
   "get": {
    "summary": "Read disk data",
    "description": "Minimum role: operator. Supports HTTP Range requests; read the data extents from the change map.",
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "disk",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Raw disk image",
      "content": {
       "application/octet-stream": {}
      }
     },
     "206": {
      "description": "Requested range",
      "content": {
       "application/octet-stream": {}
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/hosts/{host}/images": {
   "get": {
    "summary": "List images on a host",
    "description": "Requires vm.view.",
    "responses": {
     "200": {
      "description": "Images",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Image"
         }
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  },
  "/networks": {
   "get": {
    "summary": "List network definitions",
    "description": "Requires vm.view.",
    "responses": {
     "200": {
      "description": "Networks",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Network"
         }
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Define a network and create it on hosts in scope",
    "description": "Requires network.config.",
    "responses": {
     "201": {
      "description": "Created",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NetworkResult"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Network"
       }
      }
     }
    }
   }
  },
  "/networks/{name}": {
   "get": {
    "summary": "Get a network definition",
    "description": "Requires vm.view.",
    "responses": {
     "200": {
      "description": "Network",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Network"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "put": {
    "summary": "Update a network definition and apply it",
    "description": "Requires network.config.",
    "responses": {
     "200": {
      "description": "Updated",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NetworkResult"
        }
       }
      }
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Network"
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Delete a network from all hosts",
    "description": "Requires network.config.",
    "responses": {
     "204": {
      "description": "Deleted"
     },
     "4XX": {
      "description": "Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  }
 },
 "components": {
  "securitySchemes": {
   "token": {
    "type": "http",
    "scheme": "bearer",
    "description": "Personal API token from Argus Manager (user menu > API tokens). It acts with the owner's current role and scope; read-only tokens allow GET only."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     }
    }
   },
   "Host": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "datacenter": {
      "type": "string"
     },
     "cluster": {
      "type": "string"
     },
     "arch": {
      "type": "string"
     },
     "reachable": {
      "type": "boolean"
     },
     "maintenance": {
      "type": "boolean"
     },
     "error": {
      "type": "string"
