       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "host",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "post": {
    "summary": "Take a snapshot",
    "description": "Minimum role: operator.",
    "responses": {
     "202": {
      "description": "Accepted"
     },
     "4XX": {
      "description": "Error",
      "content": {
