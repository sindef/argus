        <mxCell id="ui" value="argus (Go binary, in-cluster)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;htmx UI · local auth · VNC/serial websocket proxy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
