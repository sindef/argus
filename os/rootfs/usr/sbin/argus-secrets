#!/bin/sh
set -eu
marker=/var/lib/rancher/k3s/server/argus-secrets-reencrypted
wait_for() {
    i=0
    until sh -c "$1" >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -gt 120 ] && return 1
        sleep 5
    done
}
wait_for 'k3s secrets-encrypt status'
k3s secrets-encrypt status | grep -q 'Encryption Status: Enabled' || exit 0
k3s secrets-encrypt rotate-keys
wait_for 'k3s secrets-encrypt status | grep -q reencrypt_finished'
touch "$marker"
