#!/bin/sh
set -u

f=/run/argus/ha-fence
[ -f "$f" ] || exit 0
read -r last < "$f" || exit 0
[ $(( $(date +%s) - last )) -gt 60 ] || exit 0

tail -n +2 "$f" | while read -r vm replica; do
    case "$vm" in
        ''|*[!a-z0-9-]*) continue ;;
    esac
    case "$replica" in
        https://*) ;;
        *) continue ;;
    esac
    curl -sk --max-time 3 -o /dev/null "$replica/ca.pem" && continue
    if pkill -9 -f "guest=default_${vm},"; then
        logger -t argus-fence "lost manager and replica host: killed $vm"
    fi
done
