#!/bin/sh
set -u

dir=/run/argus
req=$dir/request
[ -f "$req" ] || exit 0
read -r action arg < "$req" || true

status() { echo "$1" > "$dir/status"; }

guests() { pgrep -c -x 'qemu-kvm|qemu-system-x86' || true; }

idle() {
    n=$(guests)
    [ "$n" -eq 0 ] && return 0
    status "Cancelled: $n VMs running"
    return 1
}

case "$action" in
    reboot)
        status "Rebooting"
        rm -f "$req"
        idle && systemctl reboot
        ;;
    poweroff)
        status "Shutting down"
        rm -f "$req"
        idle && systemctl poweroff
        ;;
    upgrade)
        case "${arg:-}" in
            "" | *[!A-Za-z0-9./:@_-]*)
                rm -f "$req"
                status "Update failed: invalid image reference"
                exit 1
                ;;
        esac
        status "Verifying $arg"
        rm -f "$req"
        idle || exit 1
        ref=$arg
        if [ ! -e /usr/local/argus/allow-unsigned-updates ]; then
            { read -r identity; read -r issuer; } < /usr/share/argus/upgrade-signer
            if ! HOME=$dir cosign verify --certificate-identity-regexp "$identity" --certificate-oidc-issuer "$issuer" "$arg" > "$dir/verify.json" 2> "$dir/upgrade.log"; then
                status "Update failed: $arg is not signed by the Argus release workflow"
                exit 1
            fi
            digest=$(sed -n 's/.*"docker-manifest-digest":"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' "$dir/verify.json" | head -n 1)
            [ -n "$digest" ] || { status "Update failed: no verified digest"; exit 1; }
            ref="$(printf '%s' "$arg" | sed -E 's#@.*$##; s#:[^/:]+$##')@$digest"
        fi
        status "Updating to $ref"
        idle || exit 1
        if kairos-agent upgrade --source "oci:$ref" >> "$dir/upgrade.log" 2>&1; then
            status "Rebooting into $ref"
            idle && systemctl reboot
        else
            status "Update failed, see log"
        fi
        ;;
    *)
        rm -f "$req"
        status "Unknown request"
        ;;
esac
