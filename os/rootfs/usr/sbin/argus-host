#!/bin/sh
set -u

dir=/run/argus
req=$dir/request
[ -f "$req" ] || exit 0
read -r action arg < "$req" || true
rm -f "$req"

status() { echo "$1" > "$dir/status"; }

case "$action" in
    reboot)
        status "Rebooting"
        systemctl reboot
        ;;
    poweroff)
        status "Shutting down"
        systemctl poweroff
        ;;
    upgrade)
        case "${arg:-}" in
            "" | *[!A-Za-z0-9./:@_-]*)
                status "Update failed: invalid image reference"
                exit 1
                ;;
        esac
        status "Updating to $arg"
        if kairos-agent upgrade --source "oci:$arg" > "$dir/upgrade.log" 2>&1; then
            status "Rebooting into $arg"
            systemctl reboot
        else
            status "Update failed, see log"
        fi
        ;;
    *)
        status "Unknown request"
        ;;
esac
